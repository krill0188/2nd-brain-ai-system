{
  "folders": [
    { "path": ".", "name": "2nd Brain — Drone Knowledge" }
  ],
  "settings": {
    "editor.fontSize": 14,
    "terminal.integrated.defaultProfile.osx": "zsh"
  },
  "extensions": {
    "recommendations": [
      "anthropic.claude-code",
      "google.geminicodeassist",
      "github.copilot",
      "github.copilot-chat",
      "yzhang.markdown-all-in-one",
      "davidanson.vscode-markdownlint",
      "eamodio.gitlens"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Hermes: Cron 목록",
        "type": "shell",
        "command": "hermes cron list",
        "group": "none",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Hermes: Gateway 상태",
        "type": "shell",
        "command": "hermes gateway status",
        "group": "none",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Zotero: Ingest (전체)",
        "type": "shell",
        "command": "python3 scripts/zotero-ingest.py",
        "group": "none",
        "options": { "cwd": "${workspaceFolder}" },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Zotero: Dry-run (미리보기)",
        "type": "shell",
        "command": "python3 scripts/zotero-ingest.py --dry-run",
        "group": "none",
        "options": { "cwd": "${workspaceFolder}" },
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Gate C: Knowledge Graph 생성",
        "type": "shell",
        "command": "python3 ~/.hermes/skills/understand-anything/understand-knowledge/parse-knowledge-base.py ~/2nd && python3 ~/.hermes/skills/understand-anything/understand-knowledge/merge-knowledge-graph.py ~/2nd",
        "group": "none",
        "presentation": { "reveal": "always", "panel": "shared" }
      },
      {
        "label": "Git: 상태 확인",
        "type": "shell",
        "command": "git status && git log --oneline -5",
        "group": "none",
        "options": { "cwd": "${workspaceFolder}" },
        "presentation": { "reveal": "always", "panel": "shared" }
      }
    ]
  }
}
