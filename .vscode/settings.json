{
  // ── 기본 편집기 ────────────────────────────────────────────
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.ua": true
  },
  "files.associations": {
    "*.md": "markdown"
  },

  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": false,
  "editor.linkedEditing": true,

  // ── Markdown ────────────────────────────────────────────────
  "markdown.preview.breaks": true,
  "markdown.preview.fontSize": 14,
  "markdown.validate.enabled": true,
  "[markdown]": {
    "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
    "editor.wordWrap": "on"
  },

  // ── Git ─────────────────────────────────────────────────────
  "git.enableSmartCommit": true,
  "git.autofetch": true,
  "git.confirmSync": false,

  // ── Explorer ────────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,

  // ── 통합 터미널 — AI 도구별 프로파일 ───────────────────────
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "zsh",
      "icon": "terminal"
    },
    "Hermes (Cron+Gateway)": {
      "path": "zsh",
      "args": ["-c", "echo '--- Hermes Status ---'; hermes gateway status; echo ''; hermes cron list; exec zsh"],
      "icon": "server-process",
      "color": "terminal.ansiGreen"
    },
    "OpenCode · Kimi K2": {
      "path": "zsh",
      "args": ["-c", "cd ~/2nd && opencode"],
      "icon": "sparkle",
      "color": "terminal.ansiCyan"
    },
    "Codex · Drone Code": {
      "path": "zsh",
      "args": ["-c", "cd ~/2nd && codex"],
      "icon": "code",
      "color": "terminal.ansiYellow"
    },
    "Claude Code · 2nd Brain": {
      "path": "zsh",
      "args": ["-c", "cd ~/2nd && claude"],
      "icon": "hubot",
      "color": "terminal.ansiMagenta"
    }
  },

  // ── GitHub Copilot (github.copilot 설치 후 적용) ────────────
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": true
  },

  // ── Gemini Code Assist ──────────────────────────────────────
  "geminicodeassist.enableCodeCompletion": true,

  // ── 맞춤법 검사 — 드론/AI 기술 용어 ────────────────────────
  "cSpell.words": [
    "PX4", "ArduPilot", "MAVROS", "MAVSDK", "MAVLink", "uORB",
    "datalink", "swarm", "wikilink", "frontmatter", "canonical",
    "Zotero", "Obsidian", "llm", "gitkeep", "ingest",
    "drone", "airframe", "gimbal", "lidar", "SLAM",
    "Hermes", "OpenCode", "Kimi", "openrouter"
  ],
  "svn.ignoreMissingSvnWarning": true
}
